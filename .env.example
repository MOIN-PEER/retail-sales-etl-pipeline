# Copy this file to .env and change values if needed.

# Default: a local SQLite file (no installation needed)
DATABASE_URL=sqlite:///data/warehouse.db

# To use PostgreSQL instead (e.g. started with docker compose up -d):
# DATABASE_URL=postgresql+psycopg2://etl_user:etl_password@localhost:5432/retail_dw

LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0
# Abort the load if more than this share of rows fail validation
MAX_REJECT_RATE=0.10
